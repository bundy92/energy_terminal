[
    {energy_gateway, [
        {ws_port,          8765},
        {cache_ttl_secs,   60},
        {poll_interval_ms, 30000},

        %% Per-feed rate limits (requests per minute)
        {rate_limits, [
            {yahoo_finance, 60},
            {iea,           10},
            {eia,           60},
            {open_meteo,    100},
            {fred,          120}
        ]},

        %% Feed toggle flags
        {feeds_enabled, [
            yahoo_finance,
            eia,
            open_meteo,
            fred
        ]},

        %% Instruments tracked by Yahoo Finance feed
        {instruments, [
            %% Crude
            <<"CL=F">>, <<"BZ=F">>,
            %% Natural Gas
            <<"NG=F">>,
            %% Refined Products
            <<"RB=F">>, <<"HO=F">>,
            %% Carbon / ETFs
            <<"ICLN">>, <<"XLE">>,
            %% FX
            <<"EURUSD=X">>, <<"DX-Y.NYB">>,
            %% Equities
            <<"XOM">>, <<"CVX">>, <<"BP">>, <<"SHEL">>, <<"TTE">>
        ]}
    ]},

    {lager, [
        {log_root, "log"},
        {handlers, [
            {lager_console_backend, [{level, info}]},
            {lager_file_backend,    [{file, "log/error.log"},  {level, error}]},
            {lager_file_backend,    [{file, "log/debug.log"},  {level, debug}]}
        ]},
        {colored,   true},
        {async_threshold, 20}
    ]}
].
