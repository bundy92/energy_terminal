{erl_opts, [debug_info, {parse_transform, lager_transform}]}.

{deps, [
    {cowboy, "2.10.0"},
    {jsx,    "3.1.0"},
    {hackney,"1.20.1"},
    {lager,  "3.9.2"},
    {meck,   "0.9.2"},
    {proper, "1.4.0"}
]}.

{project_plugins, [rebar3_proper, erlfmt]}.

{profiles, [
    {test, [
        {deps, [
            {meck,   "0.9.2"},
            {proper, "1.4.0"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{erlfmt, [write]}.

{shell, [
    {config, "config/sys.config"},
    {apps,   [energy_gateway]}
]}.
